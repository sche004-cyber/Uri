# Generated Python bytecode
__pycache__/
*.pyc

# Sensitive credentials - must never enter version history
credentials.json
URI.json
token.json
token.pickle
.env
.env.*
# M15 Part 1: a template, never a real secret - safe to track.
!.env.example

# Test/diagnostic session residue (regenerated by running the test suite)
uri_workspace/sessions/

# Personal/runtime state - specific to one user's install or one
# device, never shared codebase content. See
# uri_core/core/identity.py for the user_id/device_id distinction.
uri_workspace/portable_identity.json
uri_workspace/device_identity.json
uri_workspace/user_profile.json
uri_workspace/user_memory.json
uri_workspace/growth_ledger.json
uri_workspace/approvals.json
uri_workspace/users/
uri_workspace/user_accounts.json
# M22.2: persisted login session tokens (hashed, never plaintext, but
# still install-local runtime state, not source - see auth_session.py).
uri_workspace/auth_sessions.json
# M14 Part 1: this PC's persistent-server log output, not source.
uri_workspace/logs/
uri_workspace/skill_memory.json
uri_workspace/uri_memory.json
uri_workspace/friction_log.json
uri_workspace/experience.json
# M23: legacy-ambient graph store and its type-extension ledger -
# install-local runtime state, not source (per-user copies live under
# users/, already covered by uri_workspace/users/ above).
uri_workspace/graph.sqlite3
uri_workspace/graph_type_extensions.json
# M18: durable conversation transcripts and the installed-skill ledger
# are runtime state, not source (per-user copies live under users/).
uri_workspace/conversation_history/
uri_workspace/installed_skills.json

# AO-4 dev tooling: visible-worker run locks/logs/status markers
# (scripts/dev_workflow/visible_worker.py) - development-only runtime
# output, never source, never part of the URI runtime.
uri_workspace/dev_workflow/

# M33.2 B.3/B.4 URI-managed Edge weights and portable runtimes. These are
# checksum-verified local assets, not source-control artifacts.
uri_workspace/edge_models/

# Large institutional data directories, excluded by explicit decision
# (uri_workspace/linked_documents/ contains real student PDF/xlsx records
# with roll numbers; institutional_library/ and knowledge/ are large
# reference corpora). ~863MB combined - kept on disk, not tracked.
uri_workspace/linked_documents/
institutional_library/
knowledge/

# Generated/temporary working directories
cache/
temp_evidence/

# Historical test/worktree residue.  These directories contain local runner
# outputs or disposable baseline worktrees; the source evidence is captured in
# the committed milestone state reports, never by tracking the worktree copy.
.tmp_m33_1_batch4_*/
.tmp_m33_c2_pytest/
.tmp_m33_2_batch_a_pytest/
.pytest_cache/

# Claude Code harness runtime state (not a URI project file)
.claude/

# M16: user-attached files (uploaded content, not source)
uri_workspace/uploads/

# Live-test evidence capture (2026-09-14): server stdout/stderr logs and
# real Gmail-attachment content pulled down during live M30.7x scenario
# verification - install-local runtime output, and in at least one case
# (Mess Sheet_ June to Dec 2026.xlsx) a real institutional record with
# student names/roll numbers/emails, never source and never safe to push.
uri_workspace/evidence/

# Telemetry/shadow-log JSONL and the Graphify system index are real,
# privacy-scrubbed-by-design runtime state (see decision_engine.py's own
# record_shadow_trace docstring) but still install-local, regenerated
# output, not source - matches uri_workspace/logs/'s own rationale above.
uri_workspace/canonical_execution_log.jsonl
uri_workspace/decision_engine_shadow_log.jsonl
uri_workspace/graphify_index.json

# C1: isolated synthetic state, protected keys, auth fixtures and private probes.
/work/c1/
