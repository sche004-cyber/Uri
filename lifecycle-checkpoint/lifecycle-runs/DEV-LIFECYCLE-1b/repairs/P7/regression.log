        from scripts.dev_workflow.lifecycle_providers import run_worker
        tdir, inj, log, fake = r8_env
        pidfile = tmp_path / "injector.pid"
        p = subprocess.Popen([PY, str(inj), str(tdir), str(pidfile), "0.5", "stay"])
