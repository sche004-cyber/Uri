+def _flutter_load_failure(root):
+    path = f"{root}/test/broken_test.dart"
+    ev = [{"type": "suite", "suite": {"id": 0, "platform": "vm", "path": path}},
+          {"type": "testStart", "test": {"id": 1, "name": f"loading {path}", "suiteID": 0, "url": None}},
+          {"type": "error", "testID": 1, "isFailure": False,
+           "error": f'Failed to load "{path}":\nCompilation failed for testPath={path}: test/broken_test.dart:2:36: Error'},
+          {"type": "testDone", "testID": 1, "result": "error", "hidden": False},
+          {"type": "testStart", "test": {"id": 2, "name": "renders", "suiteID": 0, "url": f"file://{root}/test/w_test.dart"}},
+          {"type": "error", "testID": 2, "isFailure": True, "error": "Expected: <2>\n  Actual: <3>\n"},
+          {"type": "testDone", "testID": 2, "result": "failure", "hidden": False},
+          {"type": "done", "success": False}]
+    return "\n".join(json.dumps(e) for e in ev)
+
+
+def test_r5_02_flutter_ids_do_not_depend_on_the_worktree(tmp_path):
+    a = L.parse_flutter_machine(_flutter_load_failure(tmp_path / "A/uri_ui"), tmp_path / "A/uri_ui")
+    b = L.parse_flutter_machine(_flutter_load_failure(tmp_path / "B/uri_ui"), tmp_path / "B/uri_ui")
+    assert a["failures"] == b["failures"] and str(tmp_path) not in json.dumps(a)
+    assert a["failures"]["test/w_test.dart::renders"] == "TestFailure"
+    assert "test/broken_test.dart::loading test/broken_test.dart" in a["failures"]
+    c = L.compare(a, b, [])
+    assert c["ok"] and len(c["historical_failures"]) == 2
+
