+""")}
+    assert L.run(cfg) == S.BLOCKED
+    s = L.status(cfg)
+    assert s["repairs"] and all(r["status"] == "REFUSED" for r in s["repairs"])
+    assert "gate test tests/test_other.py did not fail before" in s["repairs"][0]["reason"]
+    assert s["candidate"] == cand and remote_tip(remote) == base
