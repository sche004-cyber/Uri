+def test_r5_02_causes_are_run_independent():
+    assert L._cause("assert 21013 == 1") == L._cause("assert 4242 == 1") == "AssertionError"
+    assert L._cause("assert <object object at 0x7f0eb3781760> is None") == "AssertionError"
+    assert L._cause("AssertionError: assert 3 == 2") == "AssertionError"
