+@pytest.mark.parametrize("failure", ["create_fails", "assign_fails"])
+def test_r2_01_uncontained_worker_makes_later_precheck_fail_closed(fake_windows, failure):
+    """R2-01: an implementer or gate that ran without a job may have left a detached grandchild that taskkill /T
+    cannot see; the next reviewer's precheck must not report contained=True."""
+    api = fake_windows(**{failure: True})
+    assert C.finish(C.spawn(["implementer"]))["contained"] is False
+    setattr(api, failure, False)                 # the failure was transient: the reviewer gets a job
+    pre = C.precheck()
+    assert pre["contained"] is False and "outside any job" in pre["reason"]
+    C.finish(C.spawn(["reviewer"]))
+    assert C.precheck()["contained"] is False    # stays fail closed for the rest of the driver process
+
+
+def test_r2_01_failed_termination_keeps_the_job_for_precheck(fake_windows):
+    """R2-01: a job whose TerminateJobObject failed is still re-checked (and terminated) by the next precheck."""
+    api = fake_windows()
+    p = C.spawn(["implementer"])
+    real_terminate, fails = api.terminate, [1]
+
+    def terminate_once_failing(job):
+        if fails:
+            fails.pop()
+            api.calls.append(("terminate-failed", job))
+            raise OSError(5, "TerminateJobObject failed")
+        real_terminate(job)
+    api.terminate = terminate_once_failing
+    r = C.finish(p)
+    assert r["contained"] is False and api.jobs[1]["active"] == 1
+    assert C._OPEN_JOBS == [1]                   # kept: the next precheck must see it
+    pre = C.precheck(wait_s=0.1)
+    assert pre["contained"] is True and pre["killed"] == 1 and api.jobs[1]["active"] == 0
+    assert ("terminate", 1) in api.calls and ("close", 1) in api.calls and C._OPEN_JOBS == []
+
+
+def test_r2_01_failed_termination_that_keeps_failing_is_not_contained(fake_windows):
+    api = fake_windows()
+    p = C.spawn(["implementer"])
+
+    def terminate_fails(job):
+        raise OSError(5, "TerminateJobObject failed")
+    api.terminate = terminate_fails
+    assert C.finish(p)["contained"] is False
+    pre = C.precheck(wait_s=0.1)
+    assert pre["contained"] is False and "earlier job" in pre["reason"]
+
+
 def test_f2_no_kernel32_is_not_contained(monkeypatch):
