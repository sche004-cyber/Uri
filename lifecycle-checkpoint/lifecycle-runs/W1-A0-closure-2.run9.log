 "open_findings": [
  {
   "id": "R16-01",
   "severity": "HIGH",
   "blocking": true,
   "title": "R1-01 link class still open: a foreign-script separator word of three or more distinct dot/stroke-shaped letters ('\u4e36\u318d\u11a2', '\u4e36\u4e3f\u4e40', '\u4e28\u4e36\u4e3f', '\u318d\u11a2\u4e36') between name and a non-core TLD is read as the name, so the link passes has_link_or_contact, mask_links, verify(), extractive(), the research surface and the A2UI validator (W1-AC12/AC15, D16)"
  },
  {
   "id": "R16-02",
   "severity": "MEDIUM",
   "blocking": true,
   "title": "netpolicy accepts 64:ff9b:1::/48 (RFC 8215 local-use NAT64) addresses embedding a private IPv4 at the /48, /56 or /64 offsets: _embedded_v4 always reads the last 32 bits and the NAT64 branch returns before the is_global check (W1-AC1)"
  },
  {
   "id": "R16-03",
   "severity": "LOW",
   "blocking": false,
   "title": "Split ending whose first piece is a common two-letter word is not joined even after a non-prose separator ('refunds-portal ~ go ld/claim', '~ he lp') - the disclosed, not owner-accepted, limitation is wider than needed"
  },
  {
   "id": "R16-04",
   "severity": "LOW",
   "blocking": false,
   "title": "SearxngProvider does not catch httpx.InvalidURL: an owner-configured SearXNG URL with an invalid IDNA host turns the research job into FAILED INTERNAL_ERROR (R11-02 pattern in search)"
  },
  {
   "id": "R16-05",
   "severity": "LOW",
   "blocking": false,
   "title": "Assist answer stored and emitted after Stop: the ask thread re-checks the grant before, not under the lock with, storing and emitting the answer (A0-AC4 race)"
  },
  {
   "id": "R16-06",
   "severity": "LOW",
   "blocking": false,
   "title": "Vision path: screenshot captured before VisionGate refusals (not qualified, busy, debounced); 'screenshot for this question' toggle persists across asks, Stop and new grants; prepare_image does not check screenshot size against viewport x DPR before masking field rectangles"
  }
 ],
