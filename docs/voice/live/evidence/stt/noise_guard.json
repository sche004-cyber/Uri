 "speech": [
  {
   "kind": "speech",
   "src": "v0_s00.wav",
   "text": "What is the weather usually like in going talk in October?",
   "vad_kept_s": 4.17,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s01.wav",
   "text": "Can you remind me what meetings I have tomorrow morning?",
   "vad_kept_s": 4.083,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s02.wav",
   "text": "How long does it take to drive from siligary to contalk?",
   "vad_kept_s": 4.373,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s03.wav",
   "text": "Explain the difference between a casual leave and an earned leave.",
   "vad_kept_s": 4.487,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s04.wav",
   "text": "Which festival holidays are left this year?",
   "vad_kept_s": 3.655,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s05.wav",
   "text": "Please summarize the last message from the finance department.",
   "vad_kept_s": 4.578,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s06.wav",
   "text": "Is the local brain running right now?",
   "vad_kept_s": 3.217,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s07.wav",
   "text": "Tell me three ways to reduce paper use in the office.",
   "vad_kept_s": 4.438,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s08.wav",
   "text": "What time is it in London when it is noon in India?",
   "vad_kept_s": 3.925,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s09.wav",
   "text": "Remember that the laboratory is closed on Friday afternoon.",
   "vad_kept_s": 4.777,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s10.wav",
   "text": "Stop.",
   "vad_kept_s": 1.784,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s11.wav",
   "text": "Open the dashboard.",
   "vad_kept_s": 2.442,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s12.wav",
   "text": "Dear sir, I request leave from October 15th to October 17th because of a family function.",
   "vad_kept_s": 7.549,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s13.wav",
   "text": "The meeting with the director is rescheduled to Monday at 3.30 in the afternoon.",
   "vad_kept_s": 5.455,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s14.wav",
   "text": "Please release the payment of Rs 5,000 to the vendor before the end of the month.",
   "vad_kept_s": 5.567,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s15.wav",
   "text": "Kindly forward the attendance register for September to the establishment section.",
   "vad_kept_s": 5.662,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s16.wav",
   "text": "I will not be able to attend the training program on Thursday due to illness.",
   "vad_kept_s": 5.314,
   "guard_drops": false
  },
  {
   "kind": "speech",
   "src": "v0_s17.wav",
   "text": "The budget proposal for the next financial year must reach this office by November 30th",
